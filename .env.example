# Modo: gemini | replay
PROVIDER=replay
# Graba una corrida real de Gemini a samples/<audio>.replay.json
RECORD=0

# --- Gemini ---
GEMINI_API_KEY=
# Usar Vertex AI en vez de API key
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Los nombres se validan en spike.py
TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
TRANSLATE_MODEL=gemini-3.5-flash-lite

# --- Idioma ---
SOURCE_LANG_DEFAULT=en
TARGET_LANGS=es,en

# --- Glosario ---
GLOSSARY_PATH=glossary.txt

# --- Límites del proceso ---
MAX_SESSIONS=10
PORT=8080