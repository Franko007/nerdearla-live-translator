# Modo: gemini | replay
PROVIDER=replay
# Graba una corrida real de Gemini a samples/<audio>.replay.json
RECORD=0

# --- Gemini ---
GEMINI_API_KEY=
# Usar Vertex AI en vez de API key
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Los nombres se validan contra el backend
TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
TRANSLATE_MODEL=gemini-3.5-flash-lite
# auto = chunked (accesible en este proyecto) | live = streaming Live API (opt-in)
# chunked = fuerza chunked
TRANSCRIBE_MODE=auto
# Modelo para chunked (vacío = 2.5-flash-lite en Vertex / 3.5-flash-lite en AI Studio)
#TRANSCRIBE_CHUNK_MODEL=gemini-2.5-flash-lite

# --- Idioma ---
SOURCE_LANG_DEFAULT=en
TARGET_LANGS=es,en

# --- Glosario ---
GLOSSARY_PATH=glossary.txt

# --- Límites del proceso ---
MAX_SESSIONS=10
PORT=8080